<?php

declare(strict_types=1);

use App\Http\Middleware\ProtectApiDocs;

return [
    /*
     * Master switch for the documentation routes. Set L5_SWAGGER_ENABLED=false
     * to make the UI, the JSON documents, and the assets return 404, which
     * ProtectApiDocs enforces on every route below.
     */
    'enabled' => env('L5_SWAGGER_ENABLED', true),

    /*
     * HTTP basic credentials demanded before the documentation is served. Set
     * both in production. Leaving either empty leaves the docs open, so only do
     * that locally.
     */
    'auth' => [
        'username' => env('L5_SWAGGER_USERNAME'),
        'password' => env('L5_SWAGGER_PASSWORD'),
    ],

    'default' => 'client',

    'documentations' => [
        'client' => [
            'api' => [
                'title' => 'Client API',
            ],

            'routes' => [
                'api' => 'api/documentation/client',
                'docs' => 'api/docs/client',
                'oauth2_callback' => 'api/oauth2-callback/client',
            ],

            'paths' => [
                'use_absolute_path' => env('L5_SWAGGER_USE_ABSOLUTE_PATH', true),
                'swagger_ui_assets_path' => env('L5_SWAGGER_UI_ASSETS_PATH', 'vendor/swagger-api/swagger-ui/dist/'),
                'docs_json' => 'client-api-docs.json',
                'docs_yaml' => 'client-api-docs.yaml',
                'format_to_use_for_docs' => env('L5_FORMAT_TO_USE_FOR_DOCS', 'json'),

                /*
                 * Only the client definition plus the shared schemas and
                 * parameters, so the backoffice operations stay out of it.
                 */
                'annotations' => [
                    base_path('app/OpenApi/Client'),
                    base_path('app/OpenApi/Schemas'),
                    base_path('app/OpenApi/Parameters'),
                ],
            ],
        ],

        'backoffice' => [
            'api' => [
                'title' => 'Backoffice API',
            ],

            'routes' => [
                'api' => 'api/documentation/backoffice',
                'docs' => 'api/docs/backoffice',
                'oauth2_callback' => 'api/oauth2-callback/backoffice',
            ],

            'paths' => [
                'use_absolute_path' => env('L5_SWAGGER_USE_ABSOLUTE_PATH', true),
                'swagger_ui_assets_path' => env('L5_SWAGGER_UI_ASSETS_PATH', 'vendor/swagger-api/swagger-ui/dist/'),
                'docs_json' => 'backoffice-api-docs.json',
                'docs_yaml' => 'backoffice-api-docs.yaml',
                'format_to_use_for_docs' => env('L5_FORMAT_TO_USE_FOR_DOCS', 'json'),

                'annotations' => [
                    base_path('app/OpenApi/Backoffice'),
                    base_path('app/OpenApi/Schemas'),
                    base_path('app/OpenApi/Parameters'),
                ],
            ],
        ],
    ],

    'defaults' => [
        'routes' => [
            /*
             * Route for accessing parsed swagger annotations.
             */
            'docs' => 'docs',

            /*
             * Route for Oauth2 authentication callback.
             */
            'oauth2_callback' => 'api/oauth2-callback',

            'middleware' => [
                'api' => [ProtectApiDocs::class],
                'asset' => [ProtectApiDocs::class],
                'docs' => [ProtectApiDocs::class],
                'oauth2_callback' => [ProtectApiDocs::class],
            ],

            'group_options' => [],
        ],

        'paths' => [
            /*
             * Absolute path to location where parsed annotations will be stored.
             */
            'docs' => storage_path('api-docs'),

            /*
             * Absolute path to directory where to export views.
             */
            'views' => base_path('resources/views/vendor/l5-swagger'),

            /*
             * Edit to set the api's base path.
             */
            'base' => env('L5_SWAGGER_BASE_PATH', null),

            'excludes' => [],
        ],

        'scanOptions' => [
            'default_processors_configuration' => [],
            'analyser' => null,
            'analysis' => null,
            'processors' => [],
            'pattern' => null,
            'exclude' => [],
            'open_api_spec_version' => env('L5_SWAGGER_OPEN_API_SPEC_VERSION', '3.0.0'),
        ],

        /*
         * Security schemes are declared as attributes on the OpenApiConfig class
         * of each definition, so nothing is defined here.
         */
        'securityDefinitions' => [
            'securitySchemes' => [],
            'security' => [],
        ],

        /*
         * Regenerate the documents on every request while developing, and never
         * in production, where they are built once during deployment.
         */
        'generate_always' => env('L5_SWAGGER_GENERATE_ALWAYS', true),

        'generate_yaml_copy' => env('L5_SWAGGER_GENERATE_YAML_COPY', false),

        /*
         * Edit to trust the proxy's ip address - needed for AWS Load Balancer.
         */
        'proxy' => false,

        'additional_config_url' => null,

        'operations_sort' => env('L5_SWAGGER_OPERATIONS_SORT', null),

        'validator_url' => null,

        'ui' => [
            'display' => [
                'dark_mode' => env('L5_SWAGGER_UI_DARK_MODE', false),
                'doc_expansion' => env('L5_SWAGGER_UI_DOC_EXPANSION', 'none'),
                'filter' => env('L5_SWAGGER_UI_FILTERS', true),
            ],

            'authorization' => [
                'persist_authorization' => env('L5_SWAGGER_UI_PERSIST_AUTHORIZATION', false),
                'oauth2' => [
                    'use_pkce_with_authorization_code_grant' => false,
                ],
            ],
        ],

        'constants' => [
            'L5_SWAGGER_CONST_HOST' => env('L5_SWAGGER_CONST_HOST', 'http://localhost'),
        ],
    ],
];
