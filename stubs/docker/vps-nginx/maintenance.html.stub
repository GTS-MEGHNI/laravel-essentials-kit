<!doctype html>
<!--
  Served by the HOST nginx when the app container is not answering — during a
  deploy, or if the stack is down. Install it on the VPS at
  /var/www/maintenance/maintenance.html (see site.conf.example).

  Deliberately self-contained: no external CSS, fonts or images, because
  everything it could reference is served by the container that is unavailable.
-->
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="refresh" content="30">
    <title>Be right back</title>
    <style>
        :root { color-scheme: light dark; }
        body {
            margin: 0; min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
            background: #f6f7f9; color: #1c1e21;
        }
        @media (prefers-color-scheme: dark) {
            body { background: #16181c; color: #e6e8eb; }
            .card { background: #1f2226; border-color: #2c3036; }
        }
        .card {
            max-width: 26rem; margin: 1.5rem; padding: 2rem;
            background: #fff; border: 1px solid #e4e6ea; border-radius: 12px;
            text-align: center;
        }
        h1 { margin: 0 0 .5rem; font-size: 1.3rem; }
        p  { margin: 0; opacity: .75; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Be right back</h1>
        <p>We are updating the application. This page refreshes automatically.</p>
    </div>
</body>
</html>
