# =============================================================================
# HOST nginx on the VPS — install as /etc/nginx/conf.d/example.com.conf
#
# This file is NOT used by any container. Replace example.com and myapp
# throughout, copy it onto the VPS, then:
#   sudo nginx -t && sudo systemctl reload nginx
#
# It also needs the maintenance page next to it:
#   sudo install -D -m 644 maintenance.html /var/www/maintenance/maintenance.html
#
# Four settings here are load-bearing and easy to get wrong:
#
#  1. proxy_buffering on. With buffering off, nginx streams the response straight
#     from php-fpm to the client, so a slow mobile connection holds a php-fpm
#     worker for the whole download. With it on, nginx drains the worker
#     immediately. proxy_request_buffering stays off so large uploads are not
#     spooled twice.
#
#  2. client_max_body_size matches upload_max_filesize and post_max_size in
#     php/php.ini. A larger value here means nginx accepts an upload PHP then
#     rejects.
#
#  3. Upstream keepalive plus `Connection ""`. HTTP/1.1 with the hop-by-hop
#     Connection header left in place opens a new TCP connection to the container
#     on every request.
#
#  4. proxy_read_timeout 65s. The container returns a 504 at 60s and php-fpm
#     reclaims the worker at 75s; a 300s host timeout only makes the client wait
#     five minutes for a request that is already dead.
# =============================================================================

upstream myapp_app {
    server 127.0.0.1:3000;

    # Reuse connections to the container instead of a fresh TCP handshake per
    # request. Requires HTTP/1.1 plus the empty Connection header set below.
    keepalive 32;
    keepalive_timeout 60s;
}

# ----------------------
# HTTP -> HTTPS redirect
# ----------------------
server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # Keep ACME renewals working over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ----------------------
# HTTPS + reverse proxy
# ----------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Matches upload_max_filesize / post_max_size in the container.
    client_max_body_size 128M;
    client_body_timeout  60s;

    access_log /var/log/nginx/example.com.access.log;
    error_log  /var/log/nginx/example.com.error.log;

    # Log how long each request took — the fastest way to find the slow endpoints
    # next time. Define this once in /etc/nginx/nginx.conf (http block):
    #   log_format timed '$remote_addr - $host "$request" $status $body_bytes_sent '
    #                    '"$http_referer" "$http_user_agent" rt=$request_time urt=$upstream_response_time';
    # then use:  access_log /var/log/nginx/example.com.access.log timed;

    location / {
        proxy_pass http://myapp_app;

        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        # The container answers with 504 at 60s, php-fpm kills the worker at 75s.
        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    65s;

        # Buffer the response: slow clients drain from nginx, not from php-fpm.
        proxy_buffering       on;
        proxy_buffer_size     16k;
        proxy_buffers         16 16k;
        proxy_busy_buffers_size 32k;

        # Do not spool a large upload on the host as well — the container's nginx
        # buffers it before PHP ever sees it.
        proxy_request_buffering off;

        # ── Deploy window ────────────────────────────────────────────────────
        # `docker compose up -d` replaces the app container, so for the length of
        # the entrypoint (dependency waits, caches, migrations) nothing answers on
        # :3000 and this proxy_pass gets connection refused. Serve a page instead
        # of nginx's bare 502: this host nginx is the only layer still running, so
        # it is the only place the page can come from. `artisan down` cannot cover
        # the window, because maintenance mode is rendered by the PHP that is
        # missing.
        #
        # =503 normalises 502 and 504 to a temporary status, so monitors and
        # crawlers treat it as a retry rather than an error. intercept_errors
        # extends the same page to a 503 the app itself returns.
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /maintenance.html;
    }

    # `internal` — reachable only via error_page, never requested directly.
    location = /maintenance.html {
        root /var/www/maintenance;
        internal;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
    }

}
