{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gts-meghni/laravel-essentials-kit",
    "description": "Kick off a Laravel API with the boilerplate already written: hardened defaults, a JSON response envelope, global exception rendering, packages, and quality gates, generated into your app as code you own.",
    "keywords": [
        "algeria",
        "api",
        "boilerplate",
        "generator",
        "gts-meghni",
        "json-api",
        "laravel",
        "laravel-essentials-kit",
        "laravel-package",
        "otp",
        "scaffolding",
        "starter-kit"
    ],
    "homepage": "https://github.com/gts-meghni/laravel-essentials-kit",
    "support": {
        "issues": "https://github.com/gts-meghni/laravel-essentials-kit/issues",
        "source": "https://github.com/gts-meghni/laravel-essentials-kit"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "GTS-MEGHNI",
            "email": "meghniucrpg@live.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "GtsMeghni\\EssentialsKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GtsMeghni\\EssentialsKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "GtsMeghni\\EssentialsKit\\EssentialsKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
